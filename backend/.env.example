# ---- Application ----
NODE_ENV=development
PORT=8080
APP_TIMEZONE=UTC
ALLOWED_ORIGINS=http://localhost:5173

# ---- PostgreSQL (14+) ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=wellora
DB_PASSWORD=wellora_pass
DB_NAME=wellora
# Set to true for managed PostgreSQL providers that require TLS (Neon, Supabase, RDS, Aiven...)
DB_SSL=false
# Optional PEM CA certificate from your provider's dashboard, if it is not in Node's trust store.
# Keep certificate verification enabled; do not use rejectUnauthorized=false.
# DB_SSL_CA="-----BEGIN CERTIFICATE----- ... -----END CERTIFICATE-----"
DB_POOL_SIZE=20

# ---- Security ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=24

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---- Pricing (the schema has no fee column, so fees are per role; cents) ----
DOCTOR_FEE_CENTS=9000
NURSE_FEE_CENTS=4200

# ---- Appointment response windows (Appointments.response_deadline) ----
APPOINTMENT_RESPONSE_HOURS=24
EMERGENCY_RESPONSE_MINUTES=15

# ---- Demo data (only when the Users table is empty) ----
SEED_DEMO_DATA=true

# ---- Demo admin (created with the demo data; change/remove it outside local development) ----
# Real admins: npm run admin:create -- --email you@example.com --name "Your Name" --password '...'
